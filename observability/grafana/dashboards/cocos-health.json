      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (method, uri) (rate(http_server_requests_milliseconds_count{service_name=\"cocos-broker-api\"}[5m]))",
          "legendFormat": "{{method}} {{uri}}"
