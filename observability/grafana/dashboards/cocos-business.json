{
  "uid": "cocos-business",
  "title": "Cocos · Business",
  "description": "Real-time business metrics (Micrometer counters) and historical figures computed from the orders ledger with a read-only user (spec 010, TEC-31).",
  "tags": [
    "cocos"
  ],
  "timezone": "utc",
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "type": "row",
      "title": "Real time (since the application started)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": [],
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "Operations per minute by side",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (side) (rate(cocos_orders_processed_total{service_name=\"cocos-broker-api\"}[5m])) * 60",
          "legendFormat": "{{side}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "opm"
        },
        "overrides": []
      },
      "options": {},
      "id": 2
    },
    {
      "type": "piechart",
      "title": "Orders by status (last hour)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (status) (increase(cocos_orders_processed_total{service_name=\"cocos-broker-api\",side=~\"BUY|SELL\"}[1h]))",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "id": 3
    },
    {
      "type": "stat",
      "title": "Rejected share (last hour)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * (sum(increase(cocos_orders_processed_total{service_name=\"cocos-broker-api\",status=\"REJECTED\"}[1h])) or vector(0)) / clamp_min(sum(increase(cocos_orders_processed_total{service_name=\"cocos-broker-api\"}[1h])) or vector(0), 1e-9)",
          "legendFormat": "__auto"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {},
      "id": 4
    },
    {
      "type": "bargauge",
      "title": "Rejections by reason (last hour)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (rejection_reason) (increase(cocos_orders_processed_total{service_name=\"cocos-broker-api\",status=\"REJECTED\"}[1h]))",
          "legendFormat": "{{rejection_reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "id": 5
    },
    {
      "type": "stat",
      "title": "Idempotent replays (last hour)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(cocos_idempotency_replays_total{service_name=\"cocos-broker-api\"}[1h])) or vector(0)",
          "legendFormat": "__auto"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "id": 6
    },
    {
      "type": "stat",
      "title": "Idempotency conflicts (last hour)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(cocos_idempotency_conflicts_total{service_name=\"cocos-broker-api\"}[1h])) or vector(0)",
          "legendFormat": "__auto"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Cancellations per minute",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (already_cancelled) (rate(cocos_orders_cancelled_total{service_name=\"cocos-broker-api\"}[5m])) * 60",
          "legendFormat": "already cancelled: {{already_cancelled}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "opm"
        },
        "overrides": []
      },
      "options": {},
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Account lock wait p95 / p99",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 8,
        "y": 13
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(cocos_account_lock_wait_milliseconds_bucket{service_name=\"cocos-broker-api\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(cocos_account_lock_wait_milliseconds_bucket{service_name=\"cocos-broker-api\"}[5m])))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {},
      "id": 9
    },
    {
      "type": "row",
      "title": "Historical (orders ledger, read-only)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "panels": [],
      "id": 10
    },
    {
      "type": "stat",
      "title": "Total transactions",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "cocos-ledger"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 18
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cocos-ledger"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT count(*) AS value FROM orders"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "id": 11
    },
    {
      "type": "stat",
      "title": "Success rate of trades",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "cocos-ledger"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 18
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cocos-ledger"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT round(100.0 * count(*) FILTER (WHERE status = 'FILLED') / NULLIF(count(*), 0), 2) AS value FROM orders WHERE side IN ('BUY', 'SELL')"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {},
      "description": "FILLED / all BUY and SELL orders",
      "id": 12
    },
    {
      "type": "stat",
      "title": "Rejection rate of trades",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "cocos-ledger"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 18
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cocos-ledger"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT round(100.0 * count(*) FILTER (WHERE status = 'REJECTED') / NULLIF(count(*), 0), 2) AS value FROM orders WHERE side IN ('BUY', 'SELL')"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {},
      "description": "REJECTED / all BUY and SELL orders",
      "id": 13
    },
    {
      "type": "piechart",
      "title": "Orders by status",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "cocos-ledger"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 18
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cocos-ledger"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT status, count(*) AS orders FROM orders GROUP BY status ORDER BY status"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "id": 14
    },
    {
      "type": "bargauge",
      "title": "Rejections by reason",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "cocos-ledger"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 22
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cocos-ledger"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT COALESCE(rejection_code, 'NOT_RECORDED') AS reason, count(*) AS rejections FROM orders WHERE status = 'REJECTED' GROUP BY 1 ORDER BY 2 DESC, 1"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "description": "Seed rejections have no recorded reason (NOT_RECORDED, before CM-01)",
      "id": 15
    },
    {
      "type": "bargauge",
      "title": "Traded volume by side (ARS)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "cocos-ledger"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 22
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cocos-ledger"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT side, sum(size * price)::numeric(18,2) AS volume FROM orders WHERE status = 'FILLED' AND side IN ('BUY', 'SELL') GROUP BY side ORDER BY side"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyARS"
        },
        "overrides": []
      },
      "options": {},
      "id": 16
    },
    {
      "type": "table",
      "title": "Deposits and withdrawals (ARS)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "cocos-ledger"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 22
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cocos-ledger"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT side, sum(size)::numeric(18,2) AS amount FROM orders WHERE status = 'FILLED' AND side IN ('CASH_IN', 'CASH_OUT') GROUP BY side ORDER BY side"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "id": 17
    },
    {
      "type": "timeseries",
      "title": "Orders per day",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "cocos-ledger"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 30
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cocos-ledger"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT date_trunc('day', datetime) AS time, count(*) AS orders FROM orders WHERE $__timeFilter(datetime) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "id": 18
    }
  ]
}